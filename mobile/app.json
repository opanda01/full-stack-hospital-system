{
  "expo": {
    "name": "HBYS Hasta",
    "slug": "hastane-sistemi-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hastane",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#0c4a6e"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
