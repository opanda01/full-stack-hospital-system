# Varsayılan (önerilen): satırı boş / tanımsız bırakın.
# Uygulama Metro proxy kullanır: http://<LAN>:8081/hbys-api → PC'deki backend :8000
# Windows'ta genelde yalnızca 8081 açıktır; doğrudan :8000 telefona kapalı kalır.
#
# Yalnızca firewall 8000'i açtıysanız doğrudan backend:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
#
# Zorla doğrudan 8000 (EXPO_PUBLIC_API_URL olmadan): EXPO_PUBLIC_API_DIRECT=1
# Android emülatör (doğrudan): EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# Metro portu (varsayılan 8081): METRO_PORT=8081
