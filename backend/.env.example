DATABASE_URL=postgresql+psycopg://hastane:hastane@localhost:5432/hastane_db
# Host'tan alembic: Docker Postgres portu = kök `.env` `POSTGRES_PUBLISH_PORT` (örn. 55432).
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

OTP_TTL_SECONDS=300
OTP_MAX_DENEME=5
OTP_RATE_LIMIT_DAKIKA=1
OTP_GUNLUK_MAX=5

BILDIRIM_BACKEND=console
TEMP_SIFRE_UZUNLUK=12

# SMTP (BILDIRIM_BACKEND=smtp iken)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Virgülle ayrılmış; boş bırakılırsa X-Forwarded-For yok sayılır
TRUSTED_PROXY_IPS=

# CORS: virgülle ayrılmış origin; * = geliştirme
CORS_ORIGINS=*

# Dakikada IP başına login; 0 = kapalı
LOGIN_RATE_LIMIT_PER_MINUTE=20

# Denetim listesi / saklama (gün); 0 = sınırsız
AUDIT_RETENTION_DAYS=365

# SQLAlchemy pool (prod: pool_size × workers < max_connections)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Redis cache (boş = CELERY_BROKER host, db /2)
REDIS_CACHE_URL=

AUTH_REGISTER_SUNSET=Sat, 01 Jan 2027 00:00:00 GMT

ENVIRONMENT=development
DOCS_ENABLED=true

PHI_ENCRYPT_ENABLED=false
PHI_ENCRYPTION_KEY=dev-phi-encryption-key-change-me!!
PHI_HMAC_KEY=dev-phi-hmac-key-change-me-too!!!!
PHI_ENCRYPTION_KEY_VERSION=1
PHI_HMAC_KEY_VERSION=1
HASTA_RETENTION_YEARS=20

ENTEGRASYON_BACKEND=mock
MOCK_ENTEGRASYON_FAIL=false
KPS_DOGRULAMA_ZORUNLU=false
MEDULA_PROVIZYON_ZORUNLU=false
NO_SHOW_RANDEVU_LIMIT=3
ENABIZ_OTOMATIK_PAKET=true
SEVK_KATKI_PAYI_TUTAR=150
NOBET_HAFTALIK_SAAT_LIMIT=48

# Mobil push (PUSH_BACKEND=expo iken)
PUSH_BACKEND=console
EXPO_ACCESS_TOKEN=

# Orthanc PACS (docker-compose orthanc servisi)
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=orthanc
